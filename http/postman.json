    {
      "name": "BAGIAN C",
      "item": [
        {
          "name": "Login & ambil token Copy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = JSON.parse(responseBody);\r\npm.environment.set(\"token\", jsonData.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Etag",
                "value": "siap010"
              },
              {
                "key": "Referer",
                "value": "https://httpbin.org"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"emilys\",\r\n    \"password\": \"emilyspass\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://dummyjson.com/auth/login",
              "protocol": "https",
              "host": [
                "dummyjson",
                "com"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Pertama login dulu dengan add user melalui raw json dengan method POST, kemudian dapatkan token.\n\nKedua buat script untuk mengirimkan access token ke environtment."
          },
          "response": []
        },
        {
          "name": "Token otomatis",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/auth/me",
              "protocol": "https",
              "host": [
                "dummyjson",
                "com"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Pertama akses informasi user lewat bearer token dan copy paste manual token dari bagian login/add user\n\nKedua adalah otomatiis tanpa copy token, cukup gunakan {{token}} di kolom token bearer untuk memanggil token yang sudah dikrimkan bagian login ke environtment."
          },
          "response": []
        }
      ]
    }
